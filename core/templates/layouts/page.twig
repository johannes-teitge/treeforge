{% extends "layouts/base.twig" %}

{% block before_main %}
  <section class="tf-page-intro">
    <div class="tf-container tf-page-intro-inner">
      <p class="tf-page-kicker">{{ site.name|default('TreeForge') }}</p>
      <h1 class="tf-page-title">{{ page.title|default('Seite') }}</h1>
    </div>
  </section>
{% endblock %}

{% block body %}
  <div class="tf-container tf-content-shell">
    <article class="tf-page-content">
      {{ content|default('')|raw }}
    </article>
  </div>
{% endblock %}