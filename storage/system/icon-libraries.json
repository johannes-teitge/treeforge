    },
    "fontawesome": {
      "enabled": true,
      "label": "Font Awesome Free",
      "css": [
        "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      ],
      "examples": [
        "fa:house",
        "far:user",
        "fab:github"
      ]
    }
  }
}