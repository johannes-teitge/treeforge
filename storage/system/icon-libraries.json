    "bootstrap-icons": {
      "enabled": true,
      "label": "Bootstrap Icons",
      "css": [
        "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      ],
      "examples": [
        "bi:house",
        "bi:envelope",
        "bi:box-arrow-up-right"
